{
  "openapi": "3.0.0",
  "info": {
    "title": "StellarSettle API",
    "version": "1.0.0",
    "description": "API specification for StellarSettle backend including Soroban contract interactions."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "EscrowStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "escrowed"
          },
          "contractId": {
            "type": "string",
            "description": "The Soroban contract ID managing the escrow",
            "example": "CA3D..."
          },
          "transactionXdr": {
            "type": "string",
            "description": "The base64 encoded transaction XDR",
            "example": "AAAA..."
          }
        },
        "required": [
          "status",
          "contractId"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "BatchPublishRequest": {
        "type": "object",
        "required": [
          "invoiceIds"
        ],
        "properties": {
          "invoiceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Ids of the draft invoices to publish."
          }
        }
      },
      "BatchPublishResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "published": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "description": "The invoices that were published."
              },
              "count": {
                "type": "integer",
                "example": 3
              }
            }
          }
        }
      },
      "RevokeKYCRequest": {
        "type": "object",
        "required": [
          "userId",
          "reviewerId"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "description": "User whose approval is being withdrawn."
          },
          "reviewerId": {
            "type": "string",
            "description": "Admin performing the revocation."
          },
          "revocationReason": {
            "type": "string",
            "description": "Recorded in the KYC audit log."
          }
        }
      },
      "BuyLimitResponse": {
        "type": "object",
        "properties": {
          "keyId": {
            "type": "string"
          },
          "maxBuyPerTx": {
            "type": "string",
            "description": "Maximum amount purchasable in a single buy transaction, in base units"
          },
          "maxBuyPerDay": {
            "type": "string",
            "description": "Maximum amount purchasable per wallet per day, in base units"
          },
          "currentSupply": {
            "type": "string",
            "description": "Current key supply, in base units"
          },
          "curveType": {
            "type": "string"
          },
          "configVersion": {
            "type": "integer"
          },
          "isActive": {
            "type": "boolean"
          },
          "contractAddress": {
            "type": "string"
          },
          "cachedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreatorKeyDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BuyLimitResponse"
          },
          {
            "type": "object",
            "properties": {
              "creatorId": {
                "type": "string"
              },
              "creatorWallet": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "CurveMigration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "migrationId": {
            "type": "string",
            "description": "On-chain proposal id"
          },
          "keyId": {
            "type": "string"
          },
          "proposalId": {
            "type": "string"
          },
          "contractAddress": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "executed",
              "expired"
            ]
          },
          "proposedParams": {
            "type": "object",
            "additionalProperties": true
          },
          "appliedParams": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "timelockExpiry": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "timelockExpired": {
            "type": "boolean"
          },
          "executable": {
            "type": "boolean"
          },
          "proposedAt": {
            "type": "string",
            "format": "date-time"
          },
          "executedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "proposalTxHash": {
            "type": "string",
            "nullable": true
          },
          "executionTxHash": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CurveMigrationList": {
        "type": "object",
        "properties": {
          "pending": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurveMigration"
            }
          },
          "executed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurveMigration"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurveMigration"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AclEntry": {
        "type": "object",
        "properties": {
          "contractAddress": {
            "type": "string"
          },
          "permittedFunctions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "removed"
            ]
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          },
          "removedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastLedger": {
            "type": "string",
            "nullable": true
          },
          "lastTxHash": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AclLogEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "contractAddress": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "add",
              "remove"
            ]
          },
          "permittedFunctions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ledgerSequence": {
            "type": "string",
            "nullable": true
          },
          "txHash": {
            "type": "string",
            "nullable": true
          },
          "actor": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AtomicSwap": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "swapId": {
            "type": "string",
            "description": "On-chain swap id"
          },
          "buyer": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "invoiceId": {
                "type": "string",
                "nullable": true
              },
              "amount": {
                "type": "string"
              }
            }
          },
          "seller": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "invoiceId": {
                "type": "string",
                "nullable": true
              },
              "amount": {
                "type": "string"
              }
            }
          },
          "fee": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "string"
              },
              "recipient": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "feeAmount": {
            "type": "string"
          },
          "txHash": {
            "type": "string",
            "nullable": true
          },
          "ledgerSequence": {
            "type": "string",
            "nullable": true
          },
          "executedAt": {
            "type": "string",
            "format": "date-time"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/kyc/submit": {
      "post": {
        "summary": "Submit KYC verification",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Verification submitted"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/kyc/webhook": {
      "post": {
        "summary": "Process a KYC provider webhook",
        "description": "Updates verification and user KYC state after validating the provider HMAC signature.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Webhook processed"
          },
          "401": {
            "description": "Invalid webhook signature"
          }
        }
      }
    },
    "/api/v1/admin": {
      "description": "Administrative routes are defined under this prefix."
    },
    "/api/v1/invoices/{id}/escrow-status": {
      "get": {
        "summary": "Get Soroban Escrow Status",
        "description": "Retrieves the on-chain escrow status for a specific invoice via Soroban smart contracts.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Invoice ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EscrowStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices/batch-publish": {
      "post": {
        "summary": "Batch publish draft invoices",
        "description": "Publishes several of the authenticated seller's draft invoices to the marketplace in a single atomic transaction. Every invoice is validated first; if any one of them cannot be published the whole batch is rejected and no invoice changes state. The 400 response lists every rejected invoice and why.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchPublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "All invoices published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchPublishResponse"
                }
              }
            }
          },
          "400": {
            "description": "Batch rejected; no invoice was changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "KYC approval required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/revoke-kyc": {
      "post": {
        "summary": "Revoke a user's KYC approval",
        "description": "Withdraws a previously granted KYC approval, returning the user to the pending state so they can be reviewed again. Only an approved user can be revoked. Requires the admin API key and an allow-listed source IP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeKYCRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "KYC revoked"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "User is not currently approved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/keys/{id}": {
      "get": {
        "summary": "Get creator key detail",
        "description": "Returns the creator key configuration, including the per-transaction buy limit. Public read; the limit is enforced on-chain.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Creator key id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CreatorKeyDetail"
                    }
                  }
                }
              }
            }
          },
          "Creator key not found": {
            "description": "Creator key not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "Bad Request": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/keys/{id}/buy-limit": {
      "get": {
        "summary": "Get per-transaction buy limit for a creator key",
        "description": "Pre-trade check: returns the per-transaction buy cap (max_buy_per_tx) and the current key supply so the frontend can clamp the buy input before submitting a transaction. Public read, cached for 60 seconds and invalidated when a key configuration update event is indexed.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Creator key id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/BuyLimitResponse"
                    }
                  }
                }
              }
            }
          },
          "Creator key not found": {
            "description": "Creator key not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "Bad Request": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/keys/{id}/curve-migrations": {
      "get": {
        "summary": "List bonding curve migrations for a creator key",
        "description": "Returns the migration proposals indexed from CurveMigrationProposed / CurveMigrationExecuted events, each with the proposed parameters, timelock expiry and status. Executed migrations are visible to any authenticated user; migrations still behind the timelock are creator-only.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Creator key id",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by status; `pending` requires creator access",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "pending",
                "executed"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CurveMigrationList"
                    }
                  }
                }
              }
            }
          },
          "Creator access required": {
            "description": "Creator access required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "Authentication required": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "Bad Request": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/acl": {
      "get": {
        "summary": "Get the contract integration ACL",
        "description": "Returns the whitelisted contract integrations and the functions each may call, projected from ACLUpdated contract events. Cached for five minutes and invalidated whenever a new ACLUpdated event is indexed. Admin only.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "contracts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AclEntry"
                          }
                        },
                        "total": {
                          "type": "integer"
                        },
                        "cachedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "Admin access required": {
            "description": "Admin access required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "Authentication required": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/acl/log": {
      "get": {
        "summary": "Get the ACL add/remove history",
        "description": "Returns the append-only audit trail of ACL changes derived from ACLUpdated events, newest first. Admin only.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AclLogEntry"
                      }
                    }
                  }
                }
              }
            }
          },
          "Admin access required": {
            "description": "Admin access required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "Authentication required": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "Bad Request": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/swaps/history": {
      "get": {
        "summary": "List atomic swaps for the authenticated wallet",
        "description": "Returns every atomic swap where the authenticated wallet is either the buyer or the seller, keyset-paginated on (executed_at, id).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from the previous page's meta.nextCursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
